# Supabase project (Dashboard -> Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable key (sb_publishable_...). Preferred name:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, still accepted when the variable above is unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret key (sb_secret_...). Bypasses Row Level Security: used only
# by API routes after their permission check (src/lib/supabase/admin.ts) and by
# server scripts. Never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SECRET_KEY=
# Legacy name, still accepted when SUPABASE_SECRET_KEY is unset:
# SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google account emails allowed to enter through Google sign-in.
QBG_ALLOWED_GOOGLE_EMAILS=teacher1@example.com,teacher2@example.com

# Google Cloud OAuth Client for the "Connect Google Drive" feature (Question
# Wise Videos: upload results to Drive). Create in Google Cloud Console —
# enable the Drive API, add the "drive.file" scope to the OAuth consent
# screen, create a Web application OAuth Client, and add
# <app origin>/api/integrations/google-drive/callback as an authorized
# redirect URI (e.g. http://localhost:5001/api/integrations/google-drive/callback
# for local dev).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Optional: override the dev-only local-login backdoor on the sign-in page
# (src/app/page.tsx). That path is compiled out entirely in production
# builds (NODE_ENV=production), so these only matter for `npm run dev`.
NEXT_PUBLIC_DEV_LOGIN_EMAIL=test@admin.com
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=admin123

# Server scripts (scripts/migrate-extract-raw-data.mjs, scripts/data/import/*):
# project URL; they use the secret key above (the importers read
# SUPABASE_SERVICE_ROLE_KEY). Falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
